# Copy this file to .env and fill in at least one key. NEVER commit the real .env.

# Which provider to try first: "groq" (default, fast/light) or "gemini".
# The other one is used automatically as a fallback if the primary fails.
LLM_PROVIDER=groq

# Groq (primary). Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Gemini (fallback). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
